// Cloudflare Workers config. Cloudflare builds with `node build.mjs`, then deploys ./dist.
{
  "name": "gta6-guide",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/edit", "/edit/*"]
  },
  "vars": { "GITHUB_REPO": "darpanarora82/gta6-tracker" },
  "observability": { "enabled": true }
}
